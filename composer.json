{
    "name": "moffhub/ussd",
    "description": "A package to make it painless to build easy scalable ussd apps",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Moffhub\\Ussd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\Ussd\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "sourcetoad/enhanced-resources": "^7.1",
        "sourcetoad/rule-helper-for-laravel": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.19",
        "orchestra/testbench": "^v10.4.0",
        "larastan/larastan": "^3.6"
    },
    "scripts": {
        "check-code": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan --memory-limit=1G"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
