{
    "name": "moffhub/ussd",
    "description": "Enterprise USSD framework for Laravel. Multi-provider support (Safaricom, Airtel, MTN), session management, menu builders, form collection, pagination, security, analytics, and i18n for African mobile networks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ussd",
        "ussd-framework",
        "safaricom",
        "airtel",
        "mtn",
        "africastalking",
        "mobile",
        "africa",
        "session-management",
        "menu-builder",
        "laravel-package",
        "unstructured-supplementary-service-data",
        "telecom"
    ],
    "homepage": "https://github.com/moffhub/ussd",
    "support": {
        "issues": "https://github.com/moffhub/ussd/issues",
        "source": "https://github.com/moffhub/ussd"
    },
    "autoload": {
        "psr-4": {
            "Moffhub\\Ussd\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\Ussd\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "laravel/framework": "^12.0",
        "sourcetoad/enhanced-resources": "^7.1",
        "sourcetoad/rule-helper-for-laravel": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.19",
        "orchestra/testbench": "^v10.4.0",
        "larastan/larastan": "^3.6",
        "rector/rector": "^2.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moffhub\\Ussd\\UssdServiceProvider"
            ],
            "aliases": {
                "Ussd": "Moffhub\\Ussd\\Facades\\Ussd"
            }
        }
    },
    "scripts": {
        "check-code": [
            "@lint",
            "@rector:check",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan --memory-limit=1G"
        ],
        "rector": [
            "vendor/bin/rector process"
        ],
        "rector:check": [
            "vendor/bin/rector process --dry-run"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
