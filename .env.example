# =============================================================================
# USSD Framework Configuration
# =============================================================================
# Copy the relevant variables to your application's .env and customize as needed.

LIBRARY_NAME="MoffHub USSD"

# -----------------------------------------------------------------------------
# Basic Settings
# -----------------------------------------------------------------------------

# Enable/disable the USSD framework
USSD_ENABLED=true

# Default menu to display when session starts
USSD_DEFAULT_MENU=main

# Session timeout in seconds (default: 300 = 5 minutes)
USSD_SESSION_TIMEOUT=300

# Session cache key prefix
USSD_SESSION_PREFIX=ussd_session_

# Maximum SMS message length
USSD_SMS_LENGTH=160

# Reserved characters for system messages
USSD_RESERVE_CHARS=50

# -----------------------------------------------------------------------------
# Navigation Configuration
# -----------------------------------------------------------------------------

# Navigation key for going back
USSD_NAV_BACK=99

# Navigation key for going home
USSD_NAV_HOME=0

# Navigation key for next page (pagination)
USSD_NAV_NEXT=00

# Navigation key for search
USSD_NAV_SEARCH=98

# Enable global navigation
USSD_GLOBAL_NAV_ENABLED=true

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------

# Grace period for session recovery (seconds, default: 600 = 10 minutes)
USSD_GRACE_PERIOD=600

# Maximum inactive time before session expires (seconds, default: 1800 = 30 minutes)
USSD_MAX_INACTIVE_TIME=1800

# Session persistence strategy: 'cache', 'database', 'hybrid'
USSD_PERSISTENCE_STRATEGY=hybrid

# Enable session migration between phone numbers
USSD_ENABLE_SESSION_MIGRATION=true

# Enable context preservation when session expires
USSD_ENABLE_CONTEXT_PRESERVATION=true

# Enable intelligent session recovery
USSD_ENABLE_INTELLIGENT_RECOVERY=true

# Cleanup interval for expired sessions (seconds, default: 3600 = 1 hour)
USSD_CLEANUP_INTERVAL=3600

# Enable session analytics tracking
USSD_ENABLE_SESSION_ANALYTICS=true

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------

# Enable caching
USSD_CACHE_ENABLED=true

# Menu content cache TTL (seconds, default: 3600 = 1 hour)
USSD_CACHE_MENU_TTL=3600

# Data provider cache TTL (seconds, default: 600 = 10 minutes)
USSD_CACHE_DATA_PROVIDER_TTL=600

# Cache driver (leave empty for default Laravel cache driver)
#USSD_CACHE_DRIVER=redis

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Enable rate limiting
USSD_RATE_LIMITING_ENABLED=true

# Enable input sanitization
USSD_INPUT_SANITIZATION_ENABLED=true

# Enable audit logging
USSD_AUDIT_LOGGING_ENABLED=true

# Strict mode - reject suspicious input instead of sanitizing
USSD_SECURITY_STRICT_MODE=false

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Maximum requests per minute
USSD_RATE_LIMIT_PER_MINUTE=10

# Maximum requests per hour
USSD_RATE_LIMIT_PER_HOUR=100

# Maximum requests per day
USSD_RATE_LIMIT_PER_DAY=500

# Use database-backed whitelist/blacklist
USSD_RATE_LIMIT_USE_DATABASE_LISTS=true

# Cache TTL for database access lists (seconds)
USSD_ACCESS_LIST_CACHE_TTL=300

# Static whitelist (comma-separated phone numbers, e.g., +254700000000,+254711111111)
#USSD_WHITELIST=

# Static blacklist (comma-separated phone numbers)
#USSD_BLACKLIST=

# -----------------------------------------------------------------------------
# Analytics Configuration
# -----------------------------------------------------------------------------

# Enable analytics
USSD_ANALYTICS_ENABLED=true

# Track user journey between menus
USSD_ANALYTICS_TRACK_JOURNEY=true

# Track performance metrics
USSD_ANALYTICS_TRACK_PERFORMANCE=true

# Analytics buffer size before flushing
USSD_ANALYTICS_BUFFER_SIZE=100

# Analytics flush interval (seconds)
USSD_ANALYTICS_FLUSH_INTERVAL=60

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------

# Enable performance profiling
USSD_PERFORMANCE_PROFILING_ENABLED=true

# Slow query threshold (milliseconds) - logs warning if exceeded
USSD_SLOW_QUERY_THRESHOLD=1000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Enable database features
USSD_DATABASE_ENABLED=true

# Database connection (leave empty for default Laravel connection)
#USSD_DATABASE_CONNECTION=mysql

# Save rate limit data to database
USSD_DB_SAVE_RATE_LIMITS=true

# Save security events to database
USSD_DB_SAVE_SECURITY_EVENTS=true

# Save sessions to database
USSD_DB_SAVE_SESSIONS=true

# Save analytics to database
USSD_DB_SAVE_ANALYTICS=true

# Save session recovery logs to database
USSD_DB_SAVE_RECOVERY_LOGS=true

# Save performance metrics to database
USSD_DB_SAVE_PERFORMANCE_METRICS=true

# Anonymize phone numbers for privacy (hash or mask)
USSD_DB_ANONYMIZE_PHONES=true

# -----------------------------------------------------------------------------
# Provider Configuration
# -----------------------------------------------------------------------------

# Default provider: 'safaricom', 'airtel', 'mtn', 'generic'
USSD_PROVIDER_DEFAULT=generic

# Auto-detect provider from request
USSD_PROVIDER_AUTO_DETECT=true

# Default country code (e.g., 254 for Kenya, 234 for Nigeria, 256 for Uganda)
USSD_COUNTRY_CODE=254

# Maximum message length (carrier-specific)
USSD_MAX_MESSAGE_LENGTH=182

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log channel (leave empty for default Laravel log channel)
#USSD_LOG_CHANNEL=stack

# Log level: debug, info, notice, warning, error, critical, alert, emergency
USSD_LOG_LEVEL=debug

# Log sensitive data (should be false in production!)
USSD_LOG_SENSITIVE_DATA=false
